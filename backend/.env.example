DATABASE_URL="mysql://smartbus:smartbus_dev_password@localhost:3307/smartbus"
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
LOG_LEVEL=info
SEED_DATE=
# Apply checked-in migrations at boot before the API accepts traffic (default true).
RUN_MIGRATIONS_ON_START=true
# Set to false on the deployed demo so only private demo sessions can be created.
PUBLIC_REGISTRATION=true
